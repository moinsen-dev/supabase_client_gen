---
import '../styles/global.css';
import { loadCockpit } from '../lib/contract';
import { loadDoctorReport } from '../lib/doctor';

interface Props {
  title: string;
  active: 'schema' | 'security' | 'functions' | 'realtime' | 'drift' | 'docs';
  /** Full-bleed pages (the graph) skip the .page wrapper. */
  fullBleed?: boolean;
}

const { title, active, fullBleed = false } = Astro.props;
const c = loadCockpit();
const functionsCount = c.edgeFunctions.length + c.rpcFunctions.length;
const report = loadDoctorReport();
const driftDot = report
  ? report.counts.error > 0
    ? 'error'
    : report.counts.warn > 0
      ? 'warn'
      : 'ok'
  : null;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

// Optional demo banner (build-time, defensive): only rendered when the
// DEMO_BANNER env var is set, e.g. in the landing page's /demo/ build.
// DEMO_BANNER_HREF (optional) adds a back link.
const demoBanner = process.env.DEMO_BANNER || null;
const demoBannerHref = process.env.DEMO_BANNER_HREF || null;

const tabs = [
  { id: 'schema', href: base, label: 'Schema', count: c.tables.length },
  { id: 'security', href: `${base}security/`, label: 'Security', count: null },
  { id: 'functions', href: `${base}functions/`, label: 'Functions', count: functionsCount },
  {
    id: 'realtime',
    href: `${base}realtime/`,
    label: 'Realtime & Storage',
    count: c.realtimeTables.length + c.buckets.length,
  },
  {
    id: 'drift',
    href: `${base}drift/`,
    label: 'Drift',
    count: report ? report.findings.length : null,
  },
  { id: 'docs', href: `${base}docs/`, label: 'Docs', count: null },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content="supabase_client_gen cockpit" />
    <title>{title} · {c.contractName} · Contract Cockpit</title>
  </head>
  <body>
    {
      demoBanner && (
        <div class="demo-banner">
          <span>{demoBanner}</span>
          {demoBannerHref && <a href={demoBannerHref}>&larr; back to landing</a>}
        </div>
      )
    }
    <header class="site-header">
      <span class="brand">
        <span class="brand-mark">⌁</span>
        Contract Cockpit
      </span>
      <span class="contract-meta">
        <span class="contract-name">{c.contractName}</span>
        <span class="pill accent">v{c.contractVersion}</span>
        <span class="pill">{c.contractDate}</span>
        {
          c.projectRef && (
            <>
              <span class="sep">·</span>
              <span class="pill" title={c.projectName ?? undefined}>
                ref: {c.projectRef}
              </span>
            </>
          )
        }
      </span>
    </header>
    <nav class="site-nav">
      {
        tabs.map((t) => (
          <a href={t.href} class={t.id === active ? 'active' : ''}>
            {t.id === 'drift' && driftDot && <span class={`drift-dot drift-dot-${driftDot}`} />}
            {t.label}
            {t.count != null && <span class="count">{t.count}</span>}
          </a>
        ))
      }
    </nav>
    <main class={fullBleed ? 'graph-shell' : undefined}>
      {fullBleed ? <slot /> : <div class="page"><slot /></div>}
    </main>
    <footer class="site-footer">
      <span>Generated by supabase_client_gen cockpit</span>
      <span class="mono">{c.contractName} · v{c.contractVersion} · {c.contractDate}</span>
    </footer>
  </body>
</html>

<style>
  /* Demo banner — only present when DEMO_BANNER is set at build time. */
  .demo-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 7px 20px;
    font-size: 12.5px;
    color: var(--accent);
    background: var(--accent-dim);
    border-bottom: 1px solid rgba(62, 207, 142, 0.3);
    flex-shrink: 0;
  }

  .demo-banner a {
    color: var(--text-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .demo-banner a:hover {
    color: var(--text);
  }
</style>
