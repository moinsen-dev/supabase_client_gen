---
import Layout from '../layouts/Layout.astro';
import SchemaGraph from '../components/SchemaGraph';
import { loadCockpit } from '../lib/contract';
import { loadDoctorReport, tableDriftStatus } from '../lib/doctor';

const c = loadCockpit();
const tableStatus = tableDriftStatus(loadDoctorReport());
---

<Layout title="Schema" active="schema" fullBleed>
  <SchemaGraph client:only="react" tables={c.tables} refs={c.refs} tableStatus={tableStatus} />
</Layout>
